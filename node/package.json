{
  "name": "mq-bridge-connect",
  "version": "0.1.0",
  "description": "Unofficial Redpanda Connect compatibility plugin for mq-bridge",
  "license": "MIT OR Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "mq-bridge-connect": "install.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./mq-bridge-plugin.json": "./mq-bridge-plugin.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "install.js",
    "checksums.json",
    "README.md",
    "mq-bridge-plugin.json",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "messaging",
    "redpanda-connect",
    "benthos",
    "mq-bridge",
    "etl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcomq/mq-bridge-connect.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "mq-bridge": ">=0.4.13 <0.5.0"
  },
  "devDependencies": {
    "mq-bridge": "0.4.13"
  }
}
